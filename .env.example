# --- Warehouse target -------------------------------------------------------
# Which warehouse the ingestion loaders write to: "duckdb" (dev) or "postgres" (prod)
F1_WAREHOUSE=duckdb
# Optional: defaults to the current calendar year.
# F1_CURRENT_SEASON=2026

# DuckDB (dev) — single-file warehouse
F1_DUCKDB_PATH=data/warehouse/f1.duckdb

# Postgres (prod) — matches docker-compose.yml
F1_PG_HOST=localhost
F1_PG_PORT=5432
F1_PG_DATABASE=f1
F1_PG_USER=f1
F1_PG_PASSWORD=f1
F1_PG_SCHEMA=raw

# --- Data lake --------------------------------------------------------------
F1_LAKE_DIR=data/raw

# --- Jolpica-F1 API ---------------------------------------------------------
F1_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
# Be a good citizen: Jolpica is volunteer-run and rate-limited.
F1_JOLPICA_RATE_LIMIT_PER_SEC=4
F1_JOLPICA_MAX_RETRIES=5

# --- FastF1 (Milestone 3) ---------------------------------------------------
F1_FASTF1_CACHE_DIR=data/fastf1_cache
# Distance grid (metres) for resampling per-lap telemetry (smaller = more rows).
F1_FASTF1_TELEMETRY_RESAMPLE_M=25

# --- Logging ----------------------------------------------------------------
F1_LOG_LEVEL=INFO
F1_LOG_JSON=false

# --- Operations -------------------------------------------------------------
# Core races/results/qualifying are always checked. Enable only heavy sources
# this deployment promises to ingest (comma-separated).
F1_HEALTH_REQUIRED_RESOURCES=
# Generic incident webhook. The optional token is sent as a Bearer credential.
F1_ALERT_WEBHOOK_URL=
F1_ALERT_WEBHOOK_BEARER_TOKEN=
F1_ALERT_WEBHOOK_TIMEOUT_SECONDS=10
