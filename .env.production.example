# Copy to .env.production before starting Compose. Replace the password outside
# local development; this file contains no live credential.
F1_PG_USER=f1
F1_PG_PASSWORD=change-me
F1_PG_DATABASE=f1
F1_CURRENT_SEASON=2026

# Source controls and structured production logging.
F1_JOLPICA_RATE_LIMIT_PER_SEC=4
F1_JOLPICA_MAX_RETRIES=5
F1_ROUND_INGEST_BUDGET_SECONDS=7200
F1_ROUND_TRANSFORM_BUDGET_SECONDS=900
F1_ROUND_ANALYTICS_BUDGET_SECONDS=900
F1_LOG_LEVEL=INFO
F1_LOG_JSON=true

# Add only heavy sources this deployment schedules and supports, for example:
# F1_HEALTH_REQUIRED_RESOURCES=laps,telemetry,positions,race_control
F1_HEALTH_REQUIRED_RESOURCES=

# Generic Slack/PagerDuty relay or incident-management webhook. Keep secrets in
# the deployment secret manager, not in a committed env file.
F1_ALERT_WEBHOOK_URL=
F1_ALERT_WEBHOOK_BEARER_TOKEN=
F1_ALERT_WEBHOOK_TIMEOUT_SECONDS=10
