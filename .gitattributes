# Normalise line endings: LF in the repo, checked out natively.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary / data
*.parquet binary
*.duckdb binary
data/dashboard/latest.duckdb filter=lfs diff=lfs merge=lfs -text
*.png binary
validation/pit-recovery-20260914/*manifest.json -text
