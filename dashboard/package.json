{
  "name": "f1-data-analytics-dashboard",
  "version": "0.0.1",
  "scripts": {
    "predev": "node ../scripts/run_python.mjs scripts/check_dashboard_snapshot.py data/dashboard/latest.duckdb",
    "prebuild": "node ../scripts/run_python.mjs scripts/check_dashboard_snapshot.py data/dashboard/latest.duckdb && npm run sources:strict",
    "prebuild:strict": "node ../scripts/run_python.mjs scripts/check_dashboard_snapshot.py data/dashboard/latest.duckdb && npm run sources:strict",
    "build": "evidence build",
    "build:strict": "evidence build:strict",
    "dev": "npm --prefix ../web run dev:all",
    "predev:evidence": "node ../scripts/run_python.mjs scripts/check_dashboard_snapshot.py data/dashboard/latest.duckdb && npm run sources:strict",
    "dev:evidence": "evidence dev --open /",
    "test": "evidence build",
    "test:dropdown": "node --conditions=browser --test ../scripts/test_race_event_dropdown.mjs",
    "test:presentation": "node --test ../scripts/test_dashboard_presentation.mjs",
    "test:interactions": "node --conditions=browser --test ../scripts/test_dashboard_interactions.mjs",
    "sources": "evidence sources",
    "sources:strict": "evidence sources --strict",
    "preview": "evidence preview",
    "audit-evidence": "node ../scripts/run_python.mjs scripts/export_audit_evidence.py",
    "presources": "npm run audit-evidence",
    "presources:strict": "npm run audit-evidence"
  },
  "engines": {
    "npm": ">=11 <12",
    "node": ">=24 <25"
  },
  "type": "module",
  "dependencies": {
    "@evidence-dev/core-components": "^5.4.2",
    "@evidence-dev/duckdb": "^2.0.1",
    "@evidence-dev/evidence": "^40.1.8"
  },
  "overrides": {
    "jsonwebtoken": "9.0.0",
    "trim@<0.0.3": ">0.0.3",
    "axios": "^1.7.4"
  }
}
